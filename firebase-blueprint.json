{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered user profile with role and usage counters",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique user identifier matching auth UID"
        },
        "userId": {
          "type": "string",
          "description": "Unique user identifier matching auth UID"
        },
        "name": {
          "type": "string",
          "description": "Display name of the user"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address"
        },
        "role": {
          "type": "string",
          "enum": ["admin", "user"],
          "description": "Role determining access privileges"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account creation timestamp"
        },
        "lastActiveAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last activity timestamp"
        },
        "searchesCount": {
          "type": "number",
          "description": "Number of symptom searches performed"
        },
        "protocolsCount": {
          "type": "number",
          "description": "Number of protocols run"
        },
        "status": {
          "type": "string",
          "enum": ["active", "inactive"],
          "description": "Account status"
        }
      },
      "required": ["id", "userId", "name", "email", "role", "createdAt"]
    },
    "UserReflection": {
      "title": "UserReflection",
      "description": "Daily reflection or personal note saved by the user",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique reflection identifier"
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID"
        },
        "date": {
          "type": "string",
          "description": "Date of reflection (YYYY-MM-DD)"
        },
        "content": {
          "type": "string",
          "description": "Reflection text note"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["id", "userId", "content", "updatedAt"]
    },
    "UserFavorite": {
      "title": "UserFavorite",
      "description": "Saved favorite symptom card or protocol",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique favorite ID"
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID"
        },
        "itemType": {
          "type": "string",
          "enum": ["symptom", "protocol"],
          "description": "Type of item favorited"
        },
        "itemId": {
          "type": "string",
          "description": "Referenced item identifier"
        },
        "title": {
          "type": "string",
          "description": "Item title"
        },
        "savedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when favorited"
        }
      },
      "required": ["id", "userId", "itemType", "itemId", "title", "savedAt"]
    },
    "UserActivity": {
      "title": "UserActivity",
      "description": "Activity log entry for searches and protocol runs",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique activity log entry ID"
        },
        "userId": {
          "type": "string",
          "description": "User UID who performed the action"
        },
        "userName": {
          "type": "string",
          "description": "User display name"
        },
        "userEmail": {
          "type": "string",
          "description": "User email address"
        },
        "action": {
          "type": "string",
          "enum": ["search", "protocol", "login", "signup"],
          "description": "Action type"
        },
        "detail": {
          "type": "string",
          "description": "Action details or search query"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of action"
        }
      },
      "required": ["id", "userId", "action", "detail", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile with role, email, and activity counters"
    },
    "/users/{userId}/reflections/{reflectionId}": {
      "schema": "UserReflection",
      "description": "Personal daily reflections"
    },
    "/users/{userId}/favorites/{favoriteId}": {
      "schema": "UserFavorite",
      "description": "Personal saved favorites"
    },
    "/users/{userId}/activity/{activityId}": {
      "schema": "UserActivity",
      "description": "User activity audit log"
    }
  }
}
