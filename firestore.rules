rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'lucas.ferreyra@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for UserProfile
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'email', 'role', 'createdAt'])
        && data.id is string && data.id == request.auth.uid
        && data.userId is string && data.userId == request.auth.uid
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() > 0 && data.email.size() <= 150
        && data.role in ['admin', 'user']
        && (data.role == 'user' || request.auth.token.email == 'lucas.ferreyra@gmail.com')
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isValidId(userId) && (
        (isOwner(userId) && isValidUser(incoming()) && incoming().userId == existing().userId && incoming().createdAt == existing().createdAt && (incoming().role == existing().role || isAdmin()))
        || isAdmin()
      );
      allow delete: if isAdmin() && isValidId(userId);

      // Subcollection: Reflections
      match /reflections/{reflectionId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(reflectionId)
          && incoming().userId == request.auth.uid
          && incoming().content is string && incoming().content.size() <= 2000;
        allow delete: if isOwner(userId) && isValidId(reflectionId);
      }

      // Subcollection: Favorites
      match /favorites/{favoriteId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(favoriteId)
          && incoming().userId == request.auth.uid
          && incoming().title is string && incoming().title.size() <= 200;
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(favoriteId);
      }

      // Subcollection: Activity
      match /activity/{activityId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidId(activityId)
          && incoming().userId == request.auth.uid
          && incoming().action in ['search', 'protocol', 'login', 'signup'];
        allow update: if false;
        allow delete: if isAdmin();
      }
    }
  }
}
